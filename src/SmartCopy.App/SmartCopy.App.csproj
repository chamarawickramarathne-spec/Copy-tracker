<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SmartCopy.Core\SmartCopy.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\smartcopy.ico" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>WFAC010</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\smartcopy.ico</ApplicationIcon>
    <AssemblyName>SmartCopy</AssemblyName>
    <RootNamespace>SmartCopy.App</RootNamespace>
    <Version>1.0.5</Version>
    <AssemblyVersion>1.0.5.0</AssemblyVersion>
    <FileVersion>1.0.5.0</FileVersion>
    <Product>SmartCopy</Product>
    <Description>Intelligent file transfer and management system for Windows.</Description>
    <Authors>SmartCopy</Authors>
  </PropertyGroup>

</Project>
